# IncidentOS Environment Configuration Template
# Copy this file to .env and configure with your local or test credentials.
# Do NOT commit actual credentials or secrets to version control.

# ==============================================================================
# 1. Mattermost Configuration (Human-Agent Interface)
# ==============================================================================
MATTERMOST_URL=http://localhost:60464
MATTERMOST_BOT_TOKEN=mm_bot_token_placeholder
MATTERMOST_TEAM_NAME=switch
MATTERMOST_CHANNEL_NAME=incidents
MATTERMOST_WEBHOOK_URL=http://localhost:60464/hooks/incoming_webhook_token_placeholder

# ==============================================================================
# 2. Switch Agent Collaboration Configuration
# ==============================================================================
# Note: Switch connection endpoints, room names, and agent auth parameters
# are managed by the local Switch runtime or environment harness.
SWITCH_ENABLED=true
SWITCH_INCIDENT_ROOM=incident-ops-bridge
SWITCH_LOG_LEVEL=INFO

# ==============================================================================
# 3. IncidentOS Backend Server (Controlled Tools & Orchestration API)
# ==============================================================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_ENVIRONMENT=development
BACKEND_LOG_LEVEL=INFO
DEMO_WORKSPACE_ROOT=demo-environment
MAX_LOG_RESULTS=100
MAX_FILE_READ_BYTES=500000
TOOL_EXECUTION_TIMEOUT_SECONDS=30

# ==============================================================================
# 4. Demo Environment (Target Spring Boot Application)
# ==============================================================================
DEMO_APP_NAME=checkout-service
DEMO_APP_PORT=8080
DEMO_APP_DIR=demo-environment
DEMO_APP_LOG_PATH=demo-environment/logs/application.log
DEMO_APP_REPO_PATH=demo-environment

# ==============================================================================
# 5. API Authentication (Agent-to-Backend Security)
# ==============================================================================
# Token required for all /api/* requests. Passed via Authorization: Bearer <token>
# or X-API-Key: <token>. Set a strong random token for local operations.
INCIDENTOS_API_TOKEN=inc_tok_placeholder_secret_replace_in_local_env

# ==============================================================================
# 6. Security & Isolation Settings
# ==============================================================================
# Force read-only access for investigation tools
STRICT_READ_ONLY_INVESTIGATION=true
# Require explicit human confirmation token for remediation approval
REQUIRE_HUMAN_APPROVAL=true
